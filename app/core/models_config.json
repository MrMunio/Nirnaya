      "server_bin": "bin/prism_llama/llama-server.exe",
      "port": 8088,
      "n_ctx": 4096,
      "n_gpu_layers": "auto",
      "enable_thinking": false,
      "dedicated_prompts": true,
      "n_perms": 1
    },
    "qwen3.5-4b-gguf": {
      "name": "Unsloth Qwen3.5-4B Dynamic GGUF",
