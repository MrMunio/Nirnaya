{
  "$schema": "./models_config.schema.json",
  "version": "1.0",
  "default_model": "qwen3-4b",
  "models": {
    "qwen2.5-0.5b": {
      "name": "Qwen2.5-0.5B-Instruct",
      "description": "Ultra-lightweight baseline dense model (~0.49B parameters)",
      "backend": "transformers",
      "model_id": "Qwen/Qwen2.5-0.5B-Instruct",
      "dtype": "float32",
      "device": "auto",
      "enable_thinking": false,
      "dedicated_prompts": true,
      "n_perms": 3
    },
    "qwen2.5-3b": {
      "name": "Qwen2.5-3B-Instruct",
      "description": "3B instruction-tuned dense model (100% choice accuracy)",
      "backend": "transformers",
      "model_id": "Qwen/Qwen2.5-3B-Instruct",
      "dtype": "bfloat16",
      "device": "auto",
      "enable_thinking": false,
      "dedicated_prompts": true,
      "n_perms": 1
    },
    "qwen3-4b": {
      "name": "Qwen3-4B",
      "description": "Qwen3 4B causal dense transformer (89.5% overall acc, 5.7% ECE)",
      "backend": "transformers",
      "model_id": "Qwen/Qwen3-4B",
      "dtype": "bfloat16",
      "device": "auto",
      "enable_thinking": false,
      "dedicated_prompts": true,
      "n_perms": 1
    },
    "bonsai-27b": {
